# Copy this file to .env in the repository root. Never commit .env.
PORT=4000
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://YOUR_LOCAL_DB_USER:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/ai_assistant_booking
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AI_PROVIDER=groq
GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-120b
FRONTEND_ORIGIN=http://127.0.0.1:3000
NODE_ENV=development
# Optional: the local web app defaults to http://127.0.0.1:4000/api.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api
